SCREEN 9
FOR I = 1 TO 100
CIRCLE (RND * 640, RND * 480), RND * 250, RND * 16
fiftyfifty = RND * 3
IF fiftyfifty > 1.5 THEN
  LINE (RND * 640, RND * 480)-(RND * 640, RND * 480), RND * 16, BF
ELSE
  LINE (RND * 640, RND * 480)-(RND * 640, RND * 480), RND * 16, B
END IF
CIRCLE (RND * 640, RND * 480), RND * 250, RND * 16
CIRCLE (RND * 640, RND * 480), RND * 250, RND * 16
CIRCLE (RND * 640, RND * 480), RND * 250, RND * 16
CIRCLE (RND * 640, RND * 480), RND * 250, RND * 16
NEXT I

